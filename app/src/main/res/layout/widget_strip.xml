<?xml version="1.0" encoding="utf-8"?>
<!-- Classic RemoteViews hourly-strip widget (Item 3). A wide 4x1
     strip: place name above 4-6 hour columns (the receiver hides the
     columns past the placement width). Text is BITMAP-rendered
     Star4000 (WidgetTextBitmapRenderer): the @font/ XML route failed
     on the Pixel launcher (all widgets rendered system sans, proved
     2026-11-16), so every text run is an ImageView fed by
     setImageViewBitmap, with the string as its content description.
     Sizes and colours match the old TextViews. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_strip_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_panel_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Live content; hidden when there is no cached state. -->
    <LinearLayout
        android:id="@+id/widget_strip_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_strip_place"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_strip_hour_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_strip_hour_label_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:id="@+id/widget_strip_hour_icon_1"
                    android:layout_width="28dp"
                    android:layout_height="28dp" />

                <ImageView
                    android:id="@+id/widget_strip_hour_temp_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_strip_hour_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_strip_hour_label_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:id="@+id/widget_strip_hour_icon_2"
                    android:layout_width="28dp"
                    android:layout_height="28dp" />

                <ImageView
                    android:id="@+id/widget_strip_hour_temp_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_strip_hour_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_strip_hour_label_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:id="@+id/widget_strip_hour_icon_3"
                    android:layout_width="28dp"
                    android:layout_height="28dp" />

                <ImageView
                    android:id="@+id/widget_strip_hour_temp_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_strip_hour_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_strip_hour_label_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:id="@+id/widget_strip_hour_icon_4"
                    android:layout_width="28dp"
                    android:layout_height="28dp" />

                <ImageView
                    android:id="@+id/widget_strip_hour_temp_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_strip_hour_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_strip_hour_label_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:id="@+id/widget_strip_hour_icon_5"
                    android:layout_width="28dp"
                    android:layout_height="28dp" />

                <ImageView
                    android:id="@+id/widget_strip_hour_temp_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_strip_hour_6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_strip_hour_label_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:id="@+id/widget_strip_hour_icon_6"
                    android:layout_width="28dp"
                    android:layout_height="28dp" />

                <ImageView
                    android:id="@+id/widget_strip_hour_temp_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Empty prompt; shown only when there is no cached state. -->
    <LinearLayout
        android:id="@+id/widget_strip_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_strip_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Open Aura Weather to load" />

    </LinearLayout>

</LinearLayout>
