<?xml version="1.0" encoding="utf-8"?>
<!-- Classic RemoteViews main widget (Item 3). Default 2x2 square,
     stretches to 4x2. Static retro chrome: navy panel, blue border,
     yellow logo box and temp, ticker-blue strip with one fact per
     update. Text is BITMAP-rendered Star4000 (WidgetTextBitmapRenderer):
     the @font/ XML route failed on the Pixel launcher (all widgets
     rendered system sans, proved 2026-11-16), so every text run is an
     ImageView fed by setImageViewBitmap, with the string as its content
     description. Sizes and colours match the old TextViews. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_panel_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Logo box: yellow wordmark on a bordered panel. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/widget_logo_bg"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <ImageView
            android:id="@+id/widget_main_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Aura Weather" />

    </LinearLayout>

    <!-- Live content; hidden when there is no cached state. -->
    <LinearLayout
        android:id="@+id/widget_main_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_main_icon"
                android:layout_width="44dp"
                android:layout_height="44dp" />

            <ImageView
                android:id="@+id/widget_main_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/widget_main_place"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />

        <ImageView
            android:id="@+id/widget_main_condition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <ImageView
            android:id="@+id/widget_main_highlow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <ImageView
            android:id="@+id/widget_main_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <!-- Empty prompt; shown only when there is no cached state. -->
    <LinearLayout
        android:id="@+id/widget_main_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_main_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Open Aura Weather to load" />

    </LinearLayout>

    <!-- Ticker strip: one fact per update, swapped on refresh. The bar
         keeps the id (visibility is toggled on it); the bitmap goes in
         the inner ImageView. -->
    <LinearLayout
        android:id="@+id/widget_main_ticker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_ticker_bg"
        android:gravity="center"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <ImageView
            android:id="@+id/widget_main_ticker_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

</LinearLayout>
