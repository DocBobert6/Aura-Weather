<?xml version="1.0" encoding="utf-8"?>
<!-- Classic RemoteViews radar widget (Item 4). 4x2: a static
     composited bitmap (newest MRMS frame over the Esri dark-gray
     basemap, CRT baked in) with a small Star4000 label line overlaid
     at the bottom. Tap anywhere opens the radar engine. The label
     bar is a translucent navy strip so the label stays readable over
     any radar colours. The label and empty prompt are BITMAP-rendered
     Star4000 (WidgetTextBitmapRenderer): the @font/ XML route failed
     on the Pixel launcher (proved 2026-11-16), so they are ImageViews
     fed by setImageViewBitmap, with the string as content description.
     NOTE: this layout is also the widget-picker preview, so the label
     bar is empty there until the first update fills it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_radar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/retro_background">

    <ImageView
        android:id="@+id/widget_radar_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Empty prompt: no selected place. -->
    <ImageView
        android:id="@+id/widget_radar_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:contentDescription="Open Aura Weather to add a place"
        android:visibility="gone" />

    <!-- Label bar over the bottom of the image. -->
    <LinearLayout
        android:id="@+id/widget_radar_label_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC0A1E5C"
        android:gravity="center"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <ImageView
            android:id="@+id/widget_radar_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

</FrameLayout>
